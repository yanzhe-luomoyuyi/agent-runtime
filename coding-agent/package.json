{
  "name": "@agent/coding-agent",
  "version": "0.1.0",
  "description": "Sandbox coding agent (analyze → edit → document) hosted on durable-agent-runtime + harness. Default LLM: DeepSeek (OpenAI-compatible).",
  "type": "module",
  "bin": {
    "coding-agent": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "fixtures",
    "ui"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "ui": "tsx src/ui-server.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@agent/contracts": "*",
    "@agent/harness": "*",
    "durable-agent-runtime": "*",
    "ignore": "^7.0.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
